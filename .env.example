# Copy this file to .env (which git ignores) and paste your key.
# Any provider works; it is recognised from the key:
#   OpenRouter sk-or-..., Anthropic sk-ant-..., OpenAI sk-..., Gemini AIza..., Groq gsk_..., xAI xai-...
LLM_API_KEY=

# Optional. Needed for OpenAI, Gemini, Groq and xAI, which have no default here.
# LLM_MODEL=anthropic/claude-opus-5.5

# Optional. For any other OpenAI-compatible endpoint, e.g. a local Ollama server.
# LLM_BASE_URL=http://localhost:11434/v1

# Optional. A different model for the reviewer, so it does not share the coder's blind spots.
# LLM_REVIEW_MODEL=openai/gpt-6-sol
