# Copy this file to .env (which git ignores) and paste your key.
# Any provider works; it is recognised from the key:
#   OpenRouter sk-or-..., Anthropic sk-ant-..., OpenAI sk-..., Gemini AIza..., Groq gsk_..., xAI xai-...
LLM_API_KEY=

# Which model each agent uses is set in settings.yaml. LLM_MODEL is only the fallback
# for an agent settings.yaml names no model for; needed for OpenAI, Gemini, Groq and xAI keys
# when settings.yaml has no default.
# LLM_MODEL=anthropic/claude-sonnet-5.5

# Optional. For any other OpenAI-compatible endpoint, e.g. a local Ollama server.
# LLM_BASE_URL=http://localhost:11434/v1
